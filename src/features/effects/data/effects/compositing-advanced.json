          "fragmentShader": "precision mediump float;\nuniform sampler2D u_texture;\nuniform vec3 u_key_color;\nuniform float u_tolerance, u_softness, u_spill_suppression;\nuniform float u_edge_enhancement, u_shadow_recovery;\nvarying vec2 v_texCoord;\n\nvec3 rgb2hsl(vec3 c) {\n  float maxc = max(c.r, max(c.g, c.b));\n  float minc = min(c.r, min(c.g, c.b));\n  float h, s, l = (maxc + minc) / 2.0;\n  \n  if (maxc == minc) {\n    h = s = 0.0;\n  } else {\n    float d = maxc - minc;\n    s = l > 0.5 ? d / (2.0 - maxc - minc) : d / (maxc + minc);\n    if (maxc == c.r) h = (c.g - c.b) / d + (c.g < c.b ? 6.0 : 0.0);\n    else if (maxc == c.g) h = (c.b - c.r) / d + 2.0;\n    else if (maxc == c.b) h = (c.r - c.g) / d + 4.0;\n    h /= 6.0;\n  }\n  return vec3(h, s, l);\n}\n\nvoid main() {\n  vec4 color = texture2D(u_texture, v_texCoord);\n  vec3 keyHSL = rgb2hsl(u_key_color);\n  vec3 colorHSL = rgb2hsl(color.rgb);\n  \n  // Calculate color distance\n  float hueDiff = abs(colorHSL.x - keyHSL.x);\n  if (hueDiff > 0.5) hueDiff = 1.0 - hueDiff;\n  \n  float satDiff = abs(colorHSL.y - keyHSL.y);\n  float lightDiff = abs(colorHSL.z - keyHSL.z);\n  \n  float distance = sqrt(hueDiff * hueDiff + satDiff * satDiff * 0.5 + lightDiff * lightDiff * 0.3);\n  \n  // Calculate alpha based on distance and tolerance\n  float alpha = smoothstep(u_tolerance - u_softness, u_tolerance + u_softness, distance);\n  \n  // Shadow recovery for darker areas\n  float shadowFactor = 1.0 - (1.0 - colorHSL.z) * u_shadow_recovery;\n  alpha = max(alpha, shadowFactor);\n  \n  // Spill suppression\n  if (u_spill_suppression > 0.0 && distance < u_tolerance * 2.0) {\n    float spillAmount = (1.0 - distance / (u_tolerance * 2.0)) * u_spill_suppression;\n    color.g = mix(color.g, (color.r + color.b) * 0.5, spillAmount);\n  }\n  \n  // Edge enhancement\n  if (u_edge_enhancement > 0.0 && alpha > 0.1 && alpha < 0.9) {\n    alpha = mix(alpha, alpha > 0.5 ? 1.0 : 0.0, u_edge_enhancement);\n  }\n  \n  gl_FragColor = vec4(color.rgb, color.a * alpha);\n}",

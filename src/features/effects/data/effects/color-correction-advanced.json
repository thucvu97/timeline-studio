          "fragmentShader": "precision mediump float;\nuniform sampler2D u_texture;\nuniform float u_shadows_hue, u_shadows_saturation;\nuniform float u_midtones_hue, u_midtones_saturation;\nuniform float u_highlights_hue, u_highlights_saturation;\nvarying vec2 v_texCoord;\n\nvec3 hueShift(vec3 color, float hue) {\n  float cosA = cos(hue * 3.14159 / 180.0);\n  float sinA = sin(hue * 3.14159 / 180.0);\n  mat3 hueMatrix = mat3(\n    cosA + (1.0 - cosA) / 3.0, 1.0/3.0 * (1.0 - cosA) - sqrt(1.0/3.0) * sinA, 1.0/3.0 * (1.0 - cosA) + sqrt(1.0/3.0) * sinA,\n    1.0/3.0 * (1.0 - cosA) + sqrt(1.0/3.0) * sinA, cosA + 1.0/3.0*(1.0 - cosA), 1.0/3.0 * (1.0 - cosA) - sqrt(1.0/3.0) * sinA,\n    1.0/3.0 * (1.0 - cosA) - sqrt(1.0/3.0) * sinA, 1.0/3.0 * (1.0 - cosA) + sqrt(1.0/3.0) * sinA, cosA + 1.0/3.0 * (1.0 - cosA)\n  );\n  return hueMatrix * color;\n}\n\nvoid main() {\n  vec4 color = texture2D(u_texture, v_texCoord);\n  float luminance = dot(color.rgb, vec3(0.299, 0.587, 0.114));\n  \n  vec3 result = color.rgb;\n  if (luminance < 0.33) {\n    result = hueShift(result, u_shadows_hue);\n    result = mix(vec3(luminance), result, u_shadows_saturation);\n  } else if (luminance < 0.66) {\n    result = hueShift(result, u_midtones_hue);\n    result = mix(vec3(luminance), result, u_midtones_saturation);\n  } else {\n    result = hueShift(result, u_highlights_hue);\n    result = mix(vec3(luminance), result, u_highlights_saturation);\n  }\n  \n  gl_FragColor = vec4(result, color.a);\n}",

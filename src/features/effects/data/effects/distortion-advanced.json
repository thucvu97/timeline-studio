          "fragmentShader": "precision mediump float;\nuniform sampler2D u_texture;\nuniform float u_grid_size, u_warp_strength;\nuniform bool u_smooth_edges;\nuniform float u_time;\nvarying vec2 v_texCoord;\n\nfloat random(vec2 st) {\n  return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);\n}\n\nvoid main() {\n  vec2 coord = v_texCoord;\n  \n  // Create mesh distortion\n  float gridStep = 1.0 / u_grid_size;\n  vec2 gridPos = floor(coord / gridStep) * gridStep;\n  vec2 localPos = (coord - gridPos) / gridStep;\n  \n  // Generate pseudo-random displacement for each grid cell\n  vec2 displacement = vec2(\n    (random(gridPos + vec2(123.45, 678.90)) - 0.5) * u_warp_strength,\n    (random(gridPos + vec2(987.65, 432.10)) - 0.5) * u_warp_strength\n  );\n  \n  // Apply smooth interpolation if enabled\n  if (u_smooth_edges) {\n    localPos = smoothstep(0.0, 1.0, localPos);\n  }\n  \n  // Apply displacement\n  coord += displacement * localPos;\n  \n  if (coord.x >= 0.0 && coord.x <= 1.0 && coord.y >= 0.0 && coord.y <= 1.0) {\n    gl_FragColor = texture2D(u_texture, coord);\n  } else {\n    gl_FragColor = vec4(0.0, 0.0, 0.0, 1.0);\n  }\n}",
